    "a": "1,000,000,000 - 5,000,000 = 995,000,000",
    "amount_out": "floor(995,000,000 * 5,000,000,000 / (500,000,000,000 + 995,000,000)) = floor(4,975,000,000,000,000,000 / 500,995,000,000) = floor(9,930,238.82) = 9,930,238 (9.930238 USDC)",
    "gross_out": "floor(1,000,000,000 * 5,000,000,000 / 501,000,000,000) = floor(9,980,039.92) = 9,980,039",
    "fee_out": "9,980,039 - 9,930,238 = 49,801 (0.049801 USDC, the 0.5% fee line)",
