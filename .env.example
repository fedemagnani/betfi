# Copy to .env and fill in. Never commit .env. Keypair paths point outside the repo (~/.config/schedina/).
# Pascal read API (REST); empty = https://data.pascal.trade, or the mock's URL on dev/demo.
PASCAL_DATA_URL=
# Pascal trade API (signed order placement); the mock's URL on dev/demo.
PASCAL_TRADE_URL=
# Pascal market-data WebSocket; empty = wss://data.pascal.trade/ws, or the mock's URL on dev/demo.
PASCAL_WS_URL=
# Hedger account owner (public key of the offline owner wallet that holds the USDC inventory).
PASCAL_HEDGER_OWNER=
# Hedger trading-key keypair file (hot, backend-only; places and cancels hedge orders, cannot withdraw).
PASCAL_HEDGER_TRADING_KEY_PATH=
# Builder account public key written into every place-order permit (D-011 builder bytes).
PASCAL_BUILDER_PUBKEY=
# Solana RPC (localnet or devnet; never mainnet, the scripts refuse it). May carry an API key: never log it.
SOLANA_RPC_URL=
# Schedina program ID; scripts/ derive it from keys/schedina-program-keypair.json when empty.
PROGRAM_ID=
# Mock AMM program ID (step 4.D, desk /tokens and /swap-quote); default 5WhsDY2XjzJoWDbe1AgJnnNgJccQwte9TgsvG4yRtHbf.
MOCK_AMM_PROGRAM_ID=
# Crank keypair file (posts resolutions, finalize/settle); default ~/.config/schedina/crank.json.
CRANK_KEYPAIR_PATH=
# Quote-signer keypair file (ed25519 key the program checks quotes against); default ~/.config/schedina/quote-signer.json.
QUOTE_SIGNER_KEYPAIR_PATH=
# Program authority = upgrade authority and Config.authority (deploys, init_config); default ~/.config/schedina/upgrade-authority.json.
AUTHORITY_KEYPAIR_PATH=
# Sponsored transactions (L8, GET/POST /relay): the desk's sponsor key pays fees and rent of the transactions users sign, so users need no SOL.
# SPONSOR_KEYPAIR_PATH: sponsor keypair file; default ~/.config/schedina/sponsor.json; relay off when the file is missing. Must not be the crank,
# quote-signer or authority key (the desk then refuses to sponsor and serves 503). Fund it with devnet SOL.
# DESK_RELAY: 1 (default when the key exists) on, 0 off. DESK_RELAY_DAILY_LAMPORTS: most simulated sponsor spend per UTC day (default 2000000000 = 2 SOL).
SPONSOR_KEYPAIR_PATH=
DESK_RELAY=
DESK_RELAY_DAILY_LAMPORTS=
# Desk SQLite database file path; default target/desk.sqlite.
DESK_DB=
# Desk HTTP/WebSocket listen address; default 127.0.0.1:8787.
DESK_LISTEN=
# Serve copy-quotes (POST /ticket/:id/copy-quote): 1/true on, 0/false off; default on for dev and demo, off for live (4.A).
DESK_COPY_QUOTE=
# EUR/USD for the euro amounts (6.0c, GET /fx): read daily from frankfurter's ECB rate (read-only, no key).
# Empty URL = https://api.frankfurter.dev/v2/rates?base=USD&quotes=EUR&providers=ECB on demo/live, no fetch on dev; DESK_FX_S=0 never fetches.
# Without a stored rate at most 7 days old, /fx serves the fallback (default 898470 = 0.89847, of 2026-10-29).
DESK_FX_URL=
DESK_FX_S=
DESK_FX_FALLBACK_PPM=
DESK_FX_FALLBACK_AS_OF=
# SOL/USD for the ≈ SOL figures (7.0c, GET /fx eur_per_sol_ppm = SOL/USD × the ECB rate): Coinbase's keyless public spot price, read every DESK_SOL_S (60) s, kept in memory.
# Empty URL = https://api.coinbase.com/v2/prices/SOL-USD/spot on demo/live, no fetch on dev; DESK_SOL_S=0 never fetches. A Pyth Hermes URL also works with DESK_SOL_API_KEY.
# Without a price read in the last 10 min, /fx serves DESK_SOL_FALLBACK_USD_U (micro-USD per SOL; default 95000000 = $95).
# DESK_SOL_API_KEY: optional bearer token (Hermes answers 401 without one since Oct 2026); never logged.
DESK_SOL_URL=
DESK_SOL_S=
DESK_SOL_FALLBACK_USD_U=
DESK_SOL_API_KEY=
# Live scores (31 Oct): Polymarket's keyless Gamma API (/events?slug=…), read every DESK_SCORES_S (20) s for started games, kept in memory.
# /card shows the score on live games and leaves out games that are over; the quoter refuses their legs. Read only while the venue clock is the wall clock (not on a replayed tape).
# Empty URL = https://gamma-api.polymarket.com on demo/live, no fetch on dev; DESK_SCORES_S=0 never fetches (a game is then judged over from its book and Pascal's times).
DESK_SCORES_URL=
DESK_SCORES_S=
# Run profile (spec section 12): dev (localnet, mock synthetic) | demo (devnet, mock replay) | live (devnet, real Pascal via proxy).
PROFILE=
# Crank + indexer (step 2.C). DESK_CHAIN=0 runs the desk without the chain listener and crank sends.
DESK_CHAIN=
# Solana PubSub URL; empty = derived from SOLANA_RPC_URL (http → ws on port + 1, https → wss).
SOLANA_WS_URL=
# Resolution poller (D-012): POST /markets/search period, /markets/resolved sweep, start after start + this; seconds.
CRANK_RESOLVE_POLL_S=
CRANK_RESOLVED_SWEEP_S=
CRANK_RESOLVE_AFTER_S=
# Crank refund timer / retry tick, ms (default 1000); full chain resync period of the indexer, s (default 60).
CRANK_TICK_MS=
INDEXER_RESYNC_S=
# Hedge desk book stream (step 4.C): HEDGE_BOOK_STREAM=0 turns off the `book` socket, pre-hedge and drift
# rebalance; most book subscriptions (50); trigger debounce (1000 ms); least gap between drift orders on a
# symbol (10000 ms); evaluation period (250 ms); REST /books fallback period (2000 ms).
HEDGE_BOOK_STREAM=
HEDGE_BOOK_MAX_SUBS=
HEDGE_DRIFT_DEBOUNCE_MS=
HEDGE_DRIFT_COOLDOWN_MS=
HEDGE_DRIFT_EVAL_MS=
HEDGE_BOOK_REST_MS=
# Devnet deploy (scripts/deploy.sh, step 3.B; docs/deploy.md). Keys directory (default ~/.config/schedina/),
# program keypair (default keys/schedina-program-keypair.json, main checkout only), and the .env the
# script reads key paths from (default this checkout's; point a worktree at the main checkout's).
# SCHEDINA_KEYS_DIR=
# PROGRAM_KEYPAIR=
# SCHEDINA_ENV_FILE=
